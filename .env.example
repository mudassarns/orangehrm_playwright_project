# Copy this file to .env and replace every placeholder.
# Never commit .env or real credentials.

# Docker Compose / MariaDB initialization.
# Keep the root and application database passwords consistent for local installation.
MARIADB_ROOT_PASSWORD=replace_with_local_db_password
MARIADB_DATABASE=
MARIADB_USER=orangehrm
MARIADB_PASSWORD=replace_with_local_db_password

# OrangeHRM Playwright project (Config.get reads QA_ prefixed names).
QA_ORANGEHRM_BASE_URL=http://localhost:8080
QA_ORANGEHRM_USERNAME=Admin
QA_ORANGEHRM_PASSWORD=replace_with_local_admin_password

# Database connection from tests running on the host.
QA_DB_HOST=127.0.0.1
QA_DB_PORT=3306
QA_DB_NAME=orangehrm
QA_DB_USER=root
QA_DB_PASSWORD=replace_with_local_db_password

# Optional Gmail integration. Required only for tests/test_email.py.
QA_GMAIL_ADDRESS=replace_with_your_gmail_address
QA_GMAIL_APP_PASSWORD=replace_with_gmail_app_password
QA_GMAIL_OAUTH_CLIENT_FILE=gmail_oauth_client.json
QA_GMAIL_TOKEN_FILE=gmail_token.json

# Create the OAuth client JSON and token JSON yourself. Do not put their contents here.
